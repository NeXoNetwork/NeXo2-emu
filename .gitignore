# --- Dependencias (Externals) ---
# No ignoramos la carpeta 'externals' completa porque usamos submódulos.
# Git ya sabe que debe rastrear el puntero del submódulo, 
# pero ignoramos cualquier basura que se genere dentro de ellos.
externals/*/build/
externals/*/bin/

# --- Archivos que genera el programa al ejecutarse ---
imgui.ini
Testing/

# --- Homebrew de terceros para pruebas (no se suben al repo) ---
tests/homebrew/
# Tarjeta SD emulada (datos de los programas)
sdmc/

Claude outputs/
